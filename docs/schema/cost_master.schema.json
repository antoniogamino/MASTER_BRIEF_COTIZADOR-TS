{
  "$defs": {
    "FxRate": {
      "additionalProperties": false,
      "description": "Tipo de cambio: 1 ``base`` = rate ``quote``. Ej: base=USD, quote=MXN, current=18.40.",
      "properties": {
        "base": {
          "title": "Base",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "reference_fx": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Reference Fx"
        },
        "current_fx": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Current Fx"
        },
        "protected_fx": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Protected Fx"
        },
        "fx_date": {
          "format": "date",
          "title": "Fx Date",
          "type": "string"
        },
        "fx_source": {
          "title": "Fx Source",
          "type": "string"
        },
        "is_sample": {
          "default": false,
          "title": "Is Sample",
          "type": "boolean"
        }
      },
      "required": [
        "base",
        "quote",
        "reference_fx",
        "current_fx",
        "protected_fx",
        "fx_date",
        "fx_source"
      ],
      "title": "FxRate",
      "type": "object"
    },
