          "title": "Overall"
        },
        "missing_items": {
          "items": {
            "type": "string"
          },
          "title": "Missing Items",
          "type": "array"
        }
      },
      "required": [
        "by_category",
        "overall",
        "missing_items"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Impact": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
