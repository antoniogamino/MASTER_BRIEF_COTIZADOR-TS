# Copiar a .env y ajustar. NUNCA subir .env a git.
TSQ_ENV=development                 # development | test | production
TSQ_DATABASE_URL=sqlite:///data/tsq.db
TSQ_STORAGE_DIR=data/projects
TSQ_RULES_PATH=rules/default_rules_v1.yaml
TSQ_LOG_DIR=logs
TSQ_ALLOW_SAMPLE_DATA=true          # false en production

# IA (fase 4+). Nombres de modelo SOLO aquí.
TSQ_AI_PROVIDER=none                # none | anthropic   (openai / local: futuros)
TSQ_AI_API_KEY=                     # clave de console.anthropic.com
TSQ_AI_TEXT_MODEL=                  # id de modelo vigente, ver docs.claude.com/en/docs/about-claude/models
TSQ_AI_VISION_MODEL=
TSQ_AI_FALLBACK_MODEL=
TSQ_AI_TIMEOUT_S=120
